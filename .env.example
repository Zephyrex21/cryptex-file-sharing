# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=your_supabase_project_url

# Supabase Service Role Key (Settings → API → service_role key)
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase Storage bucket name (Storage → Buckets)
SUPABASE_BUCKET=your_bucket_name

# Server port (optional)
PORT=3000

# VirusTotal API key (optional — get a free one at virustotal.com/gui/join-us).
# Enables a best-effort malware pre-screen on unencrypted uploads (hash
# lookup only, not a full scan — see utils/malwareScan.js). Uploads work
# fine without this set; the check is just skipped.
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# Optional. Number of reverse proxies in front of the app (1 on Render/Heroku/
# most PaaS). Without it every visitor behind a proxy shares one IP, so the
# per-IP rate limits become one shared bucket. Leave blank when there's no
# proxy (local dev) — trusting X-Forwarded-For with no proxy lets clients
# spoof their IP and sidestep the limiters. (If your host logs
# ERR_ERL_UNEXPECTED_X_FORWARDED_FOR, that's this setting telling you to set it.)
TRUST_PROXY=

# Optional — cap how many uploads may be in flight at once (each is buffered in
# memory, up to 50 MB). Extra uploads get a 503 "retry in a few seconds".
# Default 4; raise it only if your instance has plenty of RAM.
MAX_CONCURRENT_UPLOADS=

# Optional — global storage ceiling in MB (e.g. 800 on Supabase's 1 GB free
# tier). When reached, uploads get a 507 instead of filling your quota.
# Unset/0 = no cap.
MAX_TOTAL_STORAGE_MB=

# Optional — delete PRIVATE files whose share token expired more than this many
# days ago (storage + record). Unset/0 = never delete anything automatically.
PURGE_EXPIRED_AFTER_DAYS=
