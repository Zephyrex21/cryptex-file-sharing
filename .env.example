# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=your_supabase_project_url

# Supabase Service Role Key (Settings → API → service_role key)
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase Storage bucket name (Storage → Buckets)
SUPABASE_BUCKET=your_bucket_name

# Server port (optional)
PORT=3000

# VirusTotal API key (optional — get a free one at virustotal.com/gui/join-us).
# Enables a best-effort malware pre-screen on unencrypted uploads (hash
# lookup only, not a full scan — see utils/malwareScan.js). Uploads work
# fine without this set; the check is just skipped.
VIRUSTOTAL_API_KEY=your_virustotal_api_key